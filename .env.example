# Supabase — wired in Step 2. Copy to apps/web/.env.local and fill in.
VITE_SUPABASE_URL=https://tzimctugmzuadrsitnpr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kp8TvVCeARWRqqk4z0a0CA_35y5KZgQ

# Error monitoring (Phase 7 H4) — optional. Set the web DSN to send client errors to Sentry; with
# it unset, Sentry code is tree-shaken out and errors go to the console only. (Edge Functions read
# SENTRY_DSN as a Supabase function secret, not here: `supabase secrets set SENTRY_DSN=...`.)
#
# VITE_RELEASE is NOT listed here on purpose: vite.config.ts defines it to the deploy's commit SHA
# at build time, so a value set in the environment is substituted away and never reaches the code.
# Left unset on purpose: a committed default DSN makes every fork of this repo report its
# errors into the upstream Sentry project. Set your own.
VITE_SENTRY_DSN=

# CARTO's browser-safe basemap key for the Bookshops map. Domain-restrict the key in CARTO.
# With no key, Reverie shows the nearby-store list without requesting watermarked tiles.
VITE_CARTO_BASEMAP_KEY=
