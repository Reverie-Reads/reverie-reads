# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
apps/web/.output/
apps/web/.browser-test-dist/
apps/web/.swc/
*.tsbuildinfo
.vite/

# Test / tooling artifacts
coverage/
playwright-report/
test-results/
.eslintcache

# Env / secrets
.env
.env.*
!.env.example
# The one committed env file: the local stack's public demo values (see its own header).
# Real keys stay in .env.local, which the patterns above keep ignoring.
!apps/web/.env

# Supabase local
supabase/.branches/
supabase/.temp/

# OS / editor
.DS_Store
*.local
Thumbs.db
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
data/raw/Library_App_list.xlsx
data/raw/library_connected_series.csv
# The corpus-import source CSV. Sits at the repo root because the import script takes its path as
# an argument — do not move it. It carries PERSONAL READ FLAGS, including a SECOND PERSON'S reading
# data (TC Read), so it must never be tracked: one `git add -A` without this line would commit it.
# Same class as the two data/raw files above; the gitignore gap on their sibling Chism_Books.xlsx
# is the incident this line exists to not repeat (docs/audits/pre-public-secrets.md §4).
chism-books-library.csv

# design tool exports — large (multi-MB) and regenerable from design tool; kept local for
# reference, never tracked. Ignore every export shape consistently (.html and .dc.html alike).
# The README and any handoff/review .md stay tracked.
design/from-design-tool/**/*.html
design/from-design-tool/**/*.dc.html

# Keys and certificates — no legitimate tracked file has these shapes (pre-public audit §3)
*.pem
*.key
*.p12

# Vercel CLI project linkage (org/project ids) — never tracked
.vercel/

# git worktree checkouts — a full second working copy, never repo content
.worktrees/

# Discovery-audit output (screenshots + report), regenerated on each run — never committed.
apps/web/audit-output/

# Corpus-import diagnostics (--dump). These list the owner's library book by book — a second
# person's reading data is in the same CSV the import reads, so these never get committed.
corpus-dump/
*-corpus-dump/
/.swc
/apps/web/.workflow-data/
/apps/web/.workflow-vitest/

# Local visual review evidence and browser automation sessions.
/output/
/.playwright-cli/
# Public Docker images prepared for isolated CI; never source or database backups.
.ci-supabase-images/
