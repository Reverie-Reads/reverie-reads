{
  "name": "reverie-monorepo",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter @reverie/web dev",
    "build": "pnpm --filter @reverie/core build && pnpm --filter @reverie/web build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @reverie/web e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "bash scripts/stack-lock.sh sh -c 'supabase migration up && psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -c \"NOTIFY pgrst, '\"'\"'reload schema'\"'\"';\"'",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "bash scripts/stack-lock.sh supabase db reset",
    "db:test": "supabase test db",
    "db:test:library-migration-scale": "bash scripts/stack-lock.sh bash scripts/test-library-membership-migration-scale.sh",
    "db:test:series-concurrency": "bash scripts/stack-lock.sh node scripts/test-series-archive-concurrency.mjs",
    "db:status": "supabase status",
    "db:seed": "bash scripts/stack-lock.sh node scripts/seed-dev.mjs",
    "deploy:functions": "bash scripts/deploy-guard.sh functions",
    "deploy:migrations": "bash scripts/deploy-guard.sh migrations",
    "import:corpus": "vite-node scripts/import-corpus-csv.mjs --",
    "household:link": "vite-node scripts/link-household.mjs --",
    "household:unlink": "vite-node scripts/unlink-household.mjs --",
    "corpus:admins": "vite-node scripts/set-corpus-admins.mjs --",
    "household:reconcile": "vite-node scripts/reconcile-chism-household.mjs --",
    "series:trial": "pnpm --filter @reverie/series-source-trial trial",
    "series:resolve": "pnpm --filter @reverie/series-source-trial resolver",
    "series:authority:acquire": "pnpm --filter @reverie/series-source-trial authority:acquire",
    "series:authority:qualification:freeze": "pnpm --filter @reverie/series-source-trial authority:qualification:freeze",
    "series:authority:locate": "pnpm --filter @reverie/series-source-trial authority:locate",
    "series:authority:discovery:score": "pnpm --filter @reverie/series-source-trial authority:discovery:score",
    "series:trial:score": "pnpm --filter @reverie/series-source-trial score",
    "series:sample:audit": "pnpm --filter @reverie/series-source-trial sample:audit",
    "db:test:household-concurrency": "bash scripts/stack-lock.sh node scripts/test-household-unlink-concurrency.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@supabase/supabase-js": "^2.47.10",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite-node": "^2.1.9",
    "workflow": "4.8.5"
  }
}
