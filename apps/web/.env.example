# OPTIONAL overrides only — copy to .env.local and fill in what you need. Vite only exposes
# VITE_-prefixed vars to the client. The local-stack Supabase values are NOT needed here any more:
# the committed apps/web/.env supplies them in every mode, and .env.local overrides it per-machine.

# Supabase — only override when pointing somewhere other than the committed local-stack defaults.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Social sign-in (Google/Apple). Leave unset/false until the OAuth providers are provisioned in
# Supabase auth settings; the auth screen renders the buttons inert until this is 'true'.
VITE_SOCIAL_AUTH_ENABLED=false

# CARTO's browser-safe basemap key. Obtain one from https://carto.com/basemaps/apikey/ and restrict
# it to the Reverie production and preview domains. Without it, Bookshops keeps the store list and
# suppresses the map rather than requesting watermarked tiles.
VITE_CARTO_BASEMAP_KEY=

# Buy-link attribution (docs/reference/SCALING.md). Default 'store' routes purchases to the reader's
# chosen local indie — the store keeps full profit, the app earns nothing. Set 'affiliate'
# (plus the ids below) only when you intend to earn a commission; that also surfaces a
# disclosure line. The ids are present-but-unused in 'store' mode.
VITE_BUY_ATTRIBUTION_MODE=store
VITE_BOOKSHOP_AFFILIATE_ID=
