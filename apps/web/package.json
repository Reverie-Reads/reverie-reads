    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@workflow/vitest": "4.0.21",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
