  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/assert-dist-clean.mjs",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config vitest.workflow.config.ts",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "test:watch": "vitest",
    "gen:template": "UPDATE_TEMPLATE=1 vitest run src/data/importTemplate.test.ts",
    "gen:brand-assets": "node scripts/generate-brand-assets.mjs",
    "e2e": "bash ../../scripts/stack-lock.sh playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
