         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Four cream ribbon caps share the exact gold border; shelf upright extends behind cream. Face, hair and moon refinements preserved.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">midniht-logo-vector-clean-joins</rdf:li>
            </rdf:Alt>
         </dc:title>
